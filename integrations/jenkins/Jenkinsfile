pipeline {
  agent any

  environment {
    XENOCI_API_URL = 'https://xenoci.com/api/ci/v1'
  }

  stages {
    stage('XenoCI build') {
      steps {
        withCredentials([string(credentialsId: 'XENOCAST_TOKEN', variable: 'XENOCAST_TOKEN')]) {
          sh 'bash integrations/jenkins/xenoci-build.sh'
        }
      }
    }
  }
}
